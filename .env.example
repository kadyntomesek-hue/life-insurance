# Copy to .env and fill in. Never commit .env.

# Port the server listens on
PORT=3000

# Set to true when the site is served over HTTPS (so the login cookie is HTTPS-only)
COOKIE_SECURE=false

# Optional: fixed session secret. If omitted, one is generated once and kept in data/secret.key
# SESSION_SECRET=

# Where data files live (default: ./data)
# DATA_DIR=./data

# ---- Plaid (bank connection). Leave blank to use CSV statement import only. ----
# Get these at https://dashboard.plaid.com → Developers → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake bank, free) | production (real banks, needs Plaid approval)
PLAID_ENV=sandbox
PLAID_COUNTRY=US
