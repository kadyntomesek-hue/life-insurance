# Copy this file to .env and fill in what you need. Never commit .env.

# Port the server listens on
PORT=3000

# Set to true when the site is served over HTTPS (makes the login cookie HTTPS-only)
COOKIE_SECURE=false

# Optional: fixed session secret. If omitted, one is generated once and kept in data/secret.key
# SESSION_SECRET=

# Where data files live (default: ./data)
# DATA_DIR=./data

# ---- Plaid (automatic bank sync). Leave blank to use CSV statement import only. ----
# Get these at https://dashboard.plaid.com -> Developers -> Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake bank, free) | production (real banks, needs Plaid approval)
PLAID_ENV=sandbox
PLAID_COUNTRY=US

# ---- Email leads (sending from the app). Leave blank to use "Open in mail app" instead. ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=an App Password
#        (Google Account -> Security -> 2-Step Verification -> App passwords). Your normal password will not work.
# Outlook / Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587 (also needs an app password or SMTP AUTH enabled).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The address emails come from (usually the same as SMTP_USER) and the name shown next to it
SMTP_FROM=
SMTP_FROM_NAME=
# Optional: where replies should go if different from SMTP_FROM
# SMTP_REPLY_TO=
# starttls (port 587, default) | ssl (port 465) | none
# SMTP_SECURE=starttls

# ---- AI lead analysis (optional). Claude reads each lead's notes, confirms the lead type and drafts a personal email. ----
# Get a key at https://platform.claude.com -> API keys. Without it the app still sorts leads with built-in rules.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
